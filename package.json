{
  "name": "dsh-token-cost",
  "version": "0.2.1",
  "private": true,
  "description": "Shows an estimated current-session token cost from local pi-ai catalog prices; this is not a billed amount.",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.1.7-rc.2 || ^0.2.0-rc.1"
  },
  "scripts": {
    "test": "node --test lib/*.test.js tests/*.test.js"
  }
}
